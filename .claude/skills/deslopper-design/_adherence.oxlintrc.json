{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/deslopper-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|neutral|success|warning|danger)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'neutral' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|children|note|banner|trailing|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, title, children, note, banner, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Callout> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CountChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|children|key|ref|className|style|children)$/]",
        "message": "<CountChip> doesn't accept that prop. Declared props: label, value, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|actions|footnote|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: eyebrow, title, children, actions, footnote, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Disclosure'] > JSXAttribute > JSXIdentifier[name!=/^(?:summary|meta|trailing|inline|children|key|ref|className|style|children)$/]",
        "message": "<Disclosure> doesn't accept that prop. Declared props: summary, meta, trailing, inline, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|action|large|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, children, action, large."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:facts|mono|key|ref|className|style|children)$/]",
        "message": "<FactGrid> doesn't accept that prop. Declared props: facts, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|multiline|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, multiline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|key|ref|className|style|children)$/]",
        "message": "<Glyph> doesn't accept that prop. Declared props: tone, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tonal|accent|brand)$/]",
        "message": "<Glyph> tone must be one of 'tonal' | 'accent' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Glyph> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hero'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|statement|actions|trailing|id|key|ref|className|style|children)$/]",
        "message": "<Hero> doesn't accept that prop. Declared props: eyebrow, title, statement, actions, trailing, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|subtitle|status|selected|compact|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: glyph, title, subtitle, status, selected, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|note|accent|children|key|ref|className|style|children)$/]",
        "message": "<MetricCard> doesn't accept that prop. Declared props: label, value, note, accent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|label|description|active|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: glyph, label, description, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|trailing|id|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: eyebrow, title, description, trailing, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|completed|total|detail|note|key|ref|className|style|children)$/]",
        "message": "<ProgressPanel> doesn't accept that prop. Declared props: status, completed, total, detail, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='SafetyNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|internal|key|ref|className|style|children)$/]",
        "message": "<SafetyNote> doesn't accept that prop. Declared props: title, children, internal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|title|note|key|ref|className|style|children)$/]",
        "message": "<Seal> doesn't accept that prop. Declared props: mark, title, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|description|trailing|level|id|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, description, trailing, level, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateChange'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|key|ref|className|style|children)$/]",
        "message": "<StateChange> doesn't accept that prop. Declared props: steps."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<StatusText> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusText'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:observed|unknown|limited|failed|managed)$/]",
        "message": "<StatusText> tone must be one of 'observed' | 'unknown' | 'limited' | 'failed' | 'managed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|flush|panel|as|children|key|ref|className|style|children)$/]",
        "message": "<Surface> doesn't accept that prop. Declared props: tone, flush, panel, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Surface'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|tonal|accent)$/]",
        "message": "<Surface> tone must be one of 'default' | 'tonal' | 'accent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
