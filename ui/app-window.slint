import { ScrollView } from "std-widgets.slint";
import { MaterialTheme } from "theme/material-theme.slint";
import { CleanupItemView } from "models.slint";
import { Navigation } from "components/navigation.slint";
import { SearchField } from "components/search-field.slint";
import { FilterChip } from "components/filter-chip.slint";
import { StatusSummary } from "components/status-summary.slint";
import { CleanupCard } from "components/cleanup-card.slint";
import { ComingSoon } from "components/coming-soon.slint";
import { MaterialButton } from "components/material-button.slint";
import { PlanSummary } from "components/plan-summary.slint";

export component AppWindow inherits Window {
    title: "Deslopper";
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 900px;
    min-height: 620px;
    background: MaterialTheme.background;

    in property <[CleanupItemView]> cleanup-items;
    in property <[CleanupItemView]> planned-items;
    in property <int> catalogue-count;
    in property <int> planned-count;
    in property <int> selected-filter;
    in property <int> selected-section;
    in property <bool> review-open;

    callback navigate(int);
    callback search-changed(string);
    callback filter-changed(int);
    callback toggle-plan(int);
    callback open-review;
    callback close-review;

    HorizontalLayout {
        spacing: 0px;

        Navigation {
            selected-section: root.selected-section;
            navigate(section) => { root.navigate(section); }
        }

        Rectangle {
            background: MaterialTheme.background;
            min-width: 0px;
            min-height: 0px;
            horizontal-stretch: 1;
            clip: true;

            if root.selected-section == 0: Rectangle {
                width: parent.width;
                height: parent.height;
                clip: true;
                VerticalLayout {
                    width: root.width - 224px;
                    height: parent.height - 100px;
                    padding: MaterialTheme.space-xl;
                    spacing: MaterialTheme.space-md;

                    VerticalLayout {
                        height: 72px;
                        spacing: MaterialTheme.space-xs;
                        Text { text: "Windows Cleanup"; color: MaterialTheme.text; font-size: MaterialTheme.type-title; font-weight: 760; }
                        Text {
                            text: "Review optional Windows components and promotional features. This preview never changes your system.";
                            color: MaterialTheme.secondary-text;
                            font-size: MaterialTheme.type-supporting;
                            min-width: 0px;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }

                    SearchField { edited(query) => { root.search-changed(query); } }

                    HorizontalLayout {
                        height: 40px;
                        spacing: MaterialTheme.space-xs;
                        FilterChip { label: "All"; selected: root.selected-filter == 0; activated => { root.filter-changed(0); } }
                        FilterChip { label: "Cloud"; selected: root.selected-filter == 1; activated => { root.filter-changed(1); } }
                        FilterChip { label: "AI"; selected: root.selected-filter == 2; activated => { root.filter-changed(2); } }
                        FilterChip { label: "Promotions"; selected: root.selected-filter == 3; activated => { root.filter-changed(3); } }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    StatusSummary { catalogue-count: root.catalogue-count; planned-count: root.planned-count; }

                    Rectangle {
                        height: 30px;
                        vertical-stretch: 0;
                        Text { x: 0px; width: 260px; text: "Component catalogue"; color: MaterialTheme.text; font-size: MaterialTheme.type-section; font-weight: 720; horizontal-alignment: left; vertical-alignment: center; }
                        Text { x: parent.width - 84px; width: 84px; text: root.cleanup-items.length + " shown"; color: MaterialTheme.secondary-text; font-size: MaterialTheme.type-supporting; horizontal-alignment: right; vertical-alignment: center; }
                    }

                    if root.cleanup-items.length > 0: Rectangle {
                        min-height: 0px;
                        vertical-stretch: 1;

                        catalog-scroll := ScrollView {
                            viewport-width: self.visible-width;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            VerticalLayout {
                                width: catalog-scroll.visible-width;
                                spacing: MaterialTheme.space-sm;
                                padding-right: MaterialTheme.space-xs;
                                for item in root.cleanup-items: CleanupCard {
                                    min-width: catalog-scroll.visible-width - MaterialTheme.space-xs;
                                    max-width: catalog-scroll.visible-width - MaterialTheme.space-xs;
                                    item: item;
                                    toggle-plan(id) => { root.toggle-plan(id); }
                                }
                            }
                        }
                    }

                    if root.cleanup-items.length == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: MaterialTheme.radius-card;
                        background: MaterialTheme.surface;
                        border-width: 1px;
                        border-color: MaterialTheme.outline;
                        VerticalLayout {
                            alignment: center;
                            spacing: MaterialTheme.space-xs;
                            Text { text: "No matching components"; color: MaterialTheme.text; font-size: MaterialTheme.type-section; font-weight: 700; horizontal-alignment: center; }
                            Text { text: "Try another search or choose a different category."; color: MaterialTheme.secondary-text; font-size: MaterialTheme.type-supporting; horizontal-alignment: center; }
                        }
                    }

                }
            }

            if root.selected-section == 1: ComingSoon { }
        }
    }

    if root.selected-section == 0: PlanSummary {
        x: 224px + MaterialTheme.space-xl;
        y: root.height - 84px;
        width: root.width - 224px - MaterialTheme.space-xl * 2;
        planned-count: root.planned-count;
        review => { root.open-review(); }
    }

    if root.review-open: Rectangle {
        background: MaterialTheme.scrim;

        Rectangle {
            width: min(parent.width - 64px, 660px);
            height: min(parent.height - 64px, 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 28px;
            background: MaterialTheme.elevated-surface;

            VerticalLayout {
                padding: MaterialTheme.space-xl;
                spacing: MaterialTheme.space-md;

                Text { text: "Review planned changes"; color: MaterialTheme.text; font-size: 26px; font-weight: 760; }
                Text { text: "Check the items in your local plan. Nothing here is an actual system result."; color: MaterialTheme.secondary-text; font-size: MaterialTheme.type-supporting; wrap: word-wrap; }

                Rectangle {
                    height: 64px;
                    border-radius: MaterialTheme.radius-control;
                    background: MaterialTheme.warning-container;
                    HorizontalLayout {
                        padding-left: MaterialTheme.space-md;
                        padding-right: MaterialTheme.space-md;
                        spacing: MaterialTheme.space-sm;
                        alignment: center;
                        Rectangle { width: 28px; height: 28px; border-radius: 14px; background: MaterialTheme.warning; Text { text: "!"; color: MaterialTheme.on-primary; font-size: MaterialTheme.type-body; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                        Text { text: "Preview only — Deslopper will not modify Windows in this build."; color: MaterialTheme.warning; font-size: MaterialTheme.type-supporting; font-weight: 700; wrap: word-wrap; }
                    }
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: MaterialTheme.space-xs;

                    for item in root.planned-items: Rectangle {
                        height: 70px;
                        border-radius: MaterialTheme.radius-control;
                        background: MaterialTheme.surface-tonal;
                        HorizontalLayout {
                            padding-left: MaterialTheme.space-md;
                            padding-right: MaterialTheme.space-xs;
                            spacing: MaterialTheme.space-sm;
                            alignment: center;
                            Rectangle { width: 34px; height: 34px; border-radius: 12px; background: MaterialTheme.primary-container; Text { text: item.icon-label; color: MaterialTheme.primary; font-size: MaterialTheme.type-body; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                            VerticalLayout { alignment: center; spacing: 2px; Text { text: item.name; color: MaterialTheme.text; font-size: MaterialTheme.type-body; font-weight: 700; } Text { text: item.category; color: MaterialTheme.secondary-text; font-size: MaterialTheme.type-label; } }
                            Rectangle { horizontal-stretch: 1; }
                            MaterialButton { width: 100px; text: "Remove"; primary: false; clicked => { root.toggle-plan(item.id); } }
                        }
                    }
                }

                Rectangle { height: 1px; background: MaterialTheme.outline; }

                HorizontalLayout {
                    height: 44px;
                    spacing: MaterialTheme.space-sm;
                    alignment: center;
                    Text { text: root.planned-count + (root.planned-count == 1 ? " item in plan" : " items in plan"); color: MaterialTheme.secondary-text; font-size: MaterialTheme.type-supporting; }
                    Rectangle { horizontal-stretch: 1; }
                    MaterialButton { width: 202px; text: "Apply changes — unavailable"; enabled: false; }
                    MaterialButton { width: 100px; text: "Done"; primary: false; clicked => { root.close-review(); } }
                }
            }
        }
    }
}
