import { MaterialTheme } from "../theme/material-theme.slint";

export component SearchField inherits Rectangle {
    in-out property <string> text;
    callback edited(string);

    height: 52px;
    vertical-stretch: 0;
    border-radius: MaterialTheme.radius-pill;
    background: MaterialTheme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? MaterialTheme.primary : MaterialTheme.outline;
    forward-focus: input;

    HorizontalLayout {
        padding-left: MaterialTheme.space-md;
        padding-right: MaterialTheme.space-md;
        spacing: MaterialTheme.space-sm;

        Text {
            width: 22px;
            horizontal-stretch: 0;
            text: "⌕";
            color: MaterialTheme.secondary-text;
            font-size: 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.text == "": Text {
                text: "Search components, categories, or descriptions";
                color: MaterialTheme.secondary-text;
                font-size: MaterialTheme.type-body;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            input := TextInput {
                text <=> root.text;
                color: MaterialTheme.text;
                font-size: MaterialTheme.type-body;
                selection-background-color: MaterialTheme.primary-container;
                selection-foreground-color: MaterialTheme.text;
                vertical-alignment: center;
                edited => { root.edited(root.text); }
            }
        }
    }
}
