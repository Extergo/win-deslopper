import { MaterialTheme } from "../theme/material-theme.slint";

export component MaterialButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: true;
    callback clicked;

    min-width: 104px;
    height: 44px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: MaterialTheme.radius-pill;
    background: !root.enabled ? MaterialTheme.surface-tonal : root.primary
        ? (touch.pressed ? MaterialTheme.primary-hover : MaterialTheme.primary)
        : (touch.pressed || touch.has-hover ? MaterialTheme.primary-container : MaterialTheme.surface-tonal);
    border-width: focus.has-focus ? 2px : root.primary ? 0px : 1px;
    border-color: focus.has-focus ? MaterialTheme.text : MaterialTheme.outline;
    opacity: root.enabled ? 1 : 0.58;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;

    animate background, opacity { duration: MaterialTheme.motion-fast; }

    Text {
        text: root.text;
        color: !root.enabled ? MaterialTheme.secondary-text : root.primary ? MaterialTheme.on-primary : MaterialTheme.primary;
        font-size: MaterialTheme.type-supporting;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
