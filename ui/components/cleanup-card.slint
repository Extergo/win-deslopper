import { MaterialTheme } from "../theme/material-theme.slint";
import { CleanupItemView } from "../models.slint";
import { MaterialButton } from "material-button.slint";

component InfoPill inherits Rectangle {
    in property <string> text;
    in property <bool> warning: false;

    height: 28px;
    min-width: 76px;
    border-radius: MaterialTheme.radius-pill;
    background: root.warning ? MaterialTheme.warning-container : MaterialTheme.surface-tonal;

    Text {
        text: root.text;
        color: root.warning ? MaterialTheme.warning : MaterialTheme.secondary-text;
        font-size: MaterialTheme.type-label;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CleanupCard inherits Rectangle {
    in property <CleanupItemView> item;
    callback toggle-plan(int);

    height: 232px;
    min-width: 0px;
    vertical-stretch: 0;
    border-radius: MaterialTheme.radius-card;
    background: root.item.planned ? MaterialTheme.primary-container : MaterialTheme.elevated-surface;
    border-width: root.item.planned ? 2px : 1px;
    border-color: root.item.planned ? MaterialTheme.primary : MaterialTheme.outline;

    animate background, border-color { duration: MaterialTheme.motion-fast; }

    VerticalLayout {
        padding: MaterialTheme.space-lg;
        spacing: MaterialTheme.space-sm;

        HorizontalLayout {
            height: 46px;
            spacing: MaterialTheme.space-md;

            Rectangle {
                width: 44px;
                height: 44px;
                horizontal-stretch: 0;
                border-radius: 14px;
                background: root.item.planned ? MaterialTheme.primary : MaterialTheme.surface-tonal;

                Text {
                    text: root.item.icon-label;
                    color: root.item.planned ? MaterialTheme.on-primary : MaterialTheme.primary;
                    font-size: 20px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 2px;
                Text { text: root.item.name; color: MaterialTheme.text; font-size: 19px; font-weight: 750; overflow: elide; }
                Text { text: root.item.category; color: MaterialTheme.primary; font-size: MaterialTheme.type-label; font-weight: 650; overflow: elide; }
            }

            if root.item.planned: Rectangle {
                width: 78px;
                height: 30px;
                horizontal-stretch: 0;
                border-radius: MaterialTheme.radius-pill;
                background: MaterialTheme.success-container;
                Text { text: "✓ Planned"; color: MaterialTheme.success; font-size: MaterialTheme.type-label; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }

            MaterialButton {
                width: root.item.planned ? 124px : 116px;
                text: root.item.planned ? "Remove" : "Add to plan";
                primary: !root.item.planned;
                clicked => { root.toggle-plan(root.item.id); }
            }
        }

        Text {
            height: 40px;
            min-width: 0px;
            text: root.item.description;
            color: MaterialTheme.secondary-text;
            font-size: MaterialTheme.type-supporting;
            wrap: word-wrap;
            vertical-alignment: top;
        }

        HorizontalLayout {
            height: 28px;
            spacing: MaterialTheme.space-xs;
            InfoPill { text: root.item.status; }
            InfoPill { text: root.item.risk; warning: root.item.risk == "Moderate risk"; }
            InfoPill { text: root.item.restart; }
            InfoPill { text: root.item.compatibility; }
            Rectangle { horizontal-stretch: 1; }
        }

        Rectangle { height: 1px; background: root.item.planned ? MaterialTheme.primary.with-alpha(0.22) : MaterialTheme.outline.with-alpha(0.55); }

        Text {
            height: 34px;
            min-width: 0px;
            text: root.item.proposed-actions;
            color: MaterialTheme.secondary-text;
            font-size: MaterialTheme.type-label;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
