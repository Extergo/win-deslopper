import { MaterialTheme } from "../theme/material-theme.slint";
import { MaterialButton } from "material-button.slint";

export component PlanSummary inherits Rectangle {
    in property <int> planned-count;
    callback review;

    height: 60px;
    border-radius: MaterialTheme.radius-card;
    background: root.planned-count > 0 ? MaterialTheme.primary-container : MaterialTheme.surface-tonal;

    HorizontalLayout {
        padding-left: MaterialTheme.space-lg;
        padding-right: MaterialTheme.space-sm;
        spacing: MaterialTheme.space-md;

        Rectangle {
            width: 38px;
            height: 38px;
            horizontal-stretch: 0;
            border-radius: 19px;
            background: root.planned-count > 0 ? MaterialTheme.primary : MaterialTheme.disabled;
            Text { text: root.planned-count; color: MaterialTheme.on-primary; font-size: MaterialTheme.type-body; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text { text: root.planned-count == 0 ? "No planned changes" : root.planned-count + (root.planned-count == 1 ? " planned change" : " planned changes"); color: MaterialTheme.text; font-size: MaterialTheme.type-body; font-weight: 700; }
            Text { text: "Planning is local and preview-only."; color: MaterialTheme.secondary-text; font-size: MaterialTheme.type-label; }
        }

        Rectangle { horizontal-stretch: 1; }
        MaterialButton { width: 138px; text: "Review changes"; enabled: root.planned-count > 0; clicked => { root.review(); } }
    }
}
