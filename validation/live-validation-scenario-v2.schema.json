{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deslopper scoped live-validation scenario",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "expectedMachineId",
    "expectedEdition",
    "expectedBuild",
    "expectedUpdateBuildRevision",
    "checkpointId",
    "accountClass",
    "managementContext",
    "approvalId",
    "sourceCommit",
    "sourceInspectionId",
    "inspectionEvidenceSha256",
    "approvedOperationScopes",
    "maximumPlans",
    "maximumExecutions"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "expectedMachineId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expectedEdition": { "type": "string", "minLength": 1 },
    "expectedBuild": { "type": "integer", "minimum": 22000 },
    "expectedUpdateBuildRevision": { "type": ["integer", "null"], "minimum": 0 },
    "checkpointId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "accountClass": { "enum": ["local", "microsoft", "domain", "work", "standard-user"] },
    "managementContext": { "enum": ["none", "local-policy", "domain", "mdm"] },
    "approvalId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "sourceCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "sourceInspectionId": { "type": "string", "pattern": "^inspection-[a-zA-Z0-9-]+$" },
    "inspectionEvidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approvedOperationScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "approved-validation-targets-v2.schema.json#/$defs/operationScope" }
    },
    "maximumPlans": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maximumExecutions": { "type": "integer", "minimum": 1, "maximum": 32 }
  },
  "additionalProperties": false
}
