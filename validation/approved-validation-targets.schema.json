{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deslopper local validation-target record",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordKind",
    "scenarioId",
    "targetType",
    "hashedMachineIdentity",
    "windowsEdition",
    "windowsBuild",
    "windowsUbr",
    "accountClass",
    "managementState",
    "sourceCheckpointCommit",
    "handlerVersions",
    "approvedOperations",
    "approvedTargetStates",
    "evidenceOutputLocation",
    "recoveryReadiness",
    "importantDataConfirmed",
    "backupConfirmed",
    "reinstallationAccepted",
    "winreVerified",
    "bitlockerRecoveryState",
    "recoveryMediaState",
    "developmentHostProtectionState",
    "explicitUserApprovalTimestamp",
    "approvalStatus",
    "expiresAtEpochMs",
    "restoreOrReimageProcedure",
    "validationMaturity"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordKind": { "enum": ["preparation", "approval"] },
    "scenarioId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "targetType": { "enum": ["virtual_machine", "physical_laptop"] },
    "hashedMachineIdentity": { "$ref": "#/$defs/hash" },
    "windowsEdition": { "type": "string", "minLength": 1 },
    "windowsBuild": { "type": "integer", "minimum": 22000 },
    "windowsUbr": { "type": "integer", "minimum": 0 },
    "accountClass": {
      "enum": [
        "local_administrator",
        "microsoft_account_administrator",
        "domain_administrator",
        "mdm_administrator",
        "standard_user"
      ]
    },
    "managementState": {
      "type": "object",
      "required": ["domainJoined", "entraJoined", "mdmEnrolled"],
      "properties": {
        "domainJoined": { "type": "boolean" },
        "entraJoined": { "type": "boolean" },
        "mdmEnrolled": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "sourceCheckpointCommit": { "$ref": "#/$defs/gitCommit" },
    "handlerVersions": {
      "type": "object",
      "required": [
        "set_taskbar_widgets_visibility",
        "set_taskbar_task_view_visibility",
        "set_taskbar_show_desktop_enabled"
      ],
      "properties": {
        "set_taskbar_widgets_visibility": { "type": "string", "minLength": 1 },
        "set_taskbar_task_view_visibility": { "type": "string", "minLength": 1 },
        "set_taskbar_show_desktop_enabled": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "approvedOperations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    },
    "approvedTargetStates": {
      "type": "object",
      "required": [
        "set_taskbar_widgets_visibility",
        "set_taskbar_task_view_visibility",
        "set_taskbar_show_desktop_enabled"
      ],
      "properties": {
        "set_taskbar_widgets_visibility": { "$ref": "#/$defs/targetStates" },
        "set_taskbar_task_view_visibility": { "$ref": "#/$defs/targetStates" },
        "set_taskbar_show_desktop_enabled": { "$ref": "#/$defs/targetStates" }
      },
      "additionalProperties": false
    },
    "evidenceOutputLocation": {
      "type": "string",
      "pattern": "^\\.deslopper[\\\\/]local[\\\\/]"
    },
    "recoveryReadiness": { "enum": ["not_ready", "ready_with_warnings", "ready"] },
    "importantDataConfirmed": { "type": "boolean" },
    "backupConfirmed": { "type": "boolean" },
    "reinstallationAccepted": { "type": "boolean" },
    "winreVerified": { "type": "boolean" },
    "bitlockerRecoveryState": {
      "enum": [
        "not_applicable_unencrypted",
        "recovery_material_confirmed",
        "not_confirmed",
        "unknown"
      ]
    },
    "recoveryMediaState": { "enum": ["available", "built_in_verified", "missing", "unknown"] },
    "developmentHostProtectionState": { "enum": ["present_distinct", "missing", "matches_target"] },
    "explicitUserApprovalTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "approvalStatus": { "enum": ["pending", "approved", "rejected", "expired"] },
    "expiresAtEpochMs": { "type": ["integer", "null"], "minimum": 1 },
    "restoreOrReimageProcedure": { "type": "string", "minLength": 1 },
    "validationMaturity": {
      "enum": [
        "unvalidated",
        "synthetic_tested",
        "read_only_validated",
        "live_tested_single_build",
        "live_tested_multi_build",
        "live_tested_multi_edition",
        "policy_conflict_tested",
        "recovery_tested",
        "alpha_validated",
        "rejected"
      ]
    },
    "disposableConfirmed": { "type": "boolean" },
    "expendableConfirmed": { "type": "boolean" },
    "preparationStatus": {
      "type": "object",
      "required": [
        "readOnlyStatus",
        "preparationStatus",
        "recoveryStatus",
        "mutationStatus",
        "pendingRestartReported",
        "restartVerificationState",
        "recoveryAuditSummary",
        "userConfirmations",
        "toolchainReadiness",
        "preparedAtUtc",
        "sourceBranch",
        "developmentHostHashState",
        "dedicatedTestAccountPlanState",
        "mutationStillProhibited"
      ],
      "properties": {
        "readOnlyStatus": { "enum": ["not_run", "read_only_validated"] },
        "preparationStatus": { "enum": ["preparation_incomplete", "preparation_complete"] },
        "recoveryStatus": { "enum": ["recovery_not_ready", "recovery_ready_with_warnings", "recovery_ready"] },
        "mutationStatus": { "const": "mutation_not_attempted" },
        "inspectionId": { "type": "string", "pattern": "^inspection-[a-zA-Z0-9-]+$" },
        "inspectionDurationMs": { "type": "integer", "minimum": 0 },
        "inspectionCounts": {
          "type": "object",
          "required": ["successful", "unknown", "failed", "cancelled"],
          "properties": {
            "successful": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "historyPersistenceVerified": { "type": "boolean" },
        "recoveryAuditPerformed": { "type": "boolean" },
        "pendingRestartReported": { "type": "boolean" },
        "restartVerificationState": { "enum": ["clear", "pending", "unknown"] },
        "completedCbsSessionHistoryPresent": { "type": "boolean" },
        "recoveryAuditSummary": {
          "type": "object",
          "required": [
            "winreState",
            "recoveryLocationPresent",
            "recoveryRouteAvailable",
            "encryptionState",
            "encryptionPercentage",
            "protectionState",
            "encryptionMethod",
            "restartPending",
            "noKeyMaterialAccessed"
          ],
          "properties": {
            "winreState": { "enum": ["enabled", "disabled", "unknown"] },
            "recoveryLocationPresent": { "type": "boolean" },
            "recoveryRouteAvailable": { "type": "boolean" },
            "encryptionState": { "enum": ["fully_decrypted", "encrypted", "unknown"] },
            "encryptionPercentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
            "protectionState": { "enum": ["on", "off", "suspended", "unknown"] },
            "encryptionMethod": { "type": "string", "minLength": 1 },
            "restartPending": { "type": "boolean" },
            "noKeyMaterialAccessed": { "const": true }
          },
          "additionalProperties": false
        },
        "userConfirmations": {
          "type": "object",
          "required": [
            "importantPersonalData",
            "allImportantDataBackedUp",
            "expendable",
            "reinstallAccepted",
            "recoveryMediaAvailable",
            "alternateComputerAvailable",
            "externalDriveAvailable",
            "dedicatedLocalTestAccountAllowed",
            "futureBitlockerRecoveryKeyVerification"
          ],
          "properties": {
            "importantPersonalData": { "enum": ["yes", "no"] },
            "allImportantDataBackedUp": { "enum": ["yes", "no", "not_applicable"] },
            "expendable": { "type": "boolean" },
            "reinstallAccepted": { "type": "boolean" },
            "recoveryMediaAvailable": { "type": "boolean" },
            "alternateComputerAvailable": { "type": "boolean" },
            "externalDriveAvailable": { "type": "boolean" },
            "dedicatedLocalTestAccountAllowed": { "type": "boolean" },
            "futureBitlockerRecoveryKeyVerification": { "enum": ["yes", "no"] }
          },
          "additionalProperties": false
        },
        "toolchainReadiness": { "enum": ["ready", "not_ready", "unknown"] },
        "preparedAtUtc": { "type": "string", "format": "date-time" },
        "sourceBranch": { "type": "string", "minLength": 1 },
        "developmentHostHashState": { "enum": ["missing", "present_distinct", "matches_target"] },
        "dedicatedTestAccountPlanState": { "enum": ["not_prepared", "prepared"] },
        "mutationStillProhibited": { "const": true },
        "managementAuthority": { "enum": ["none_proven", "weakly_inferred", "unknown", "active_mdm"] },
        "managementConfidence": { "enum": ["confirmed", "strong", "moderate", "weak", "unknown"] },
        "inspectionManagementDiscrepancy": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "recordKind": { "const": "preparation" } } },
      "then": {
        "required": ["preparationStatus"],
        "properties": {
          "approvalStatus": { "const": "pending" },
          "explicitUserApprovalTimestamp": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "targetType": { "const": "virtual_machine" } } },
      "then": {
        "required": ["disposableConfirmed"],
        "properties": { "disposableConfirmed": { "const": true } }
      }
    },
    {
      "if": { "properties": { "targetType": { "const": "physical_laptop" } } },
      "then": { "required": ["expendableConfirmed"] }
    },
    {
      "if": { "properties": { "approvalStatus": { "const": "approved" } } },
      "then": {
        "not": { "required": ["preparationStatus"] },
        "properties": {
          "recordKind": { "const": "approval" },
          "recoveryReadiness": { "enum": ["ready_with_warnings", "ready"] },
          "importantDataConfirmed": { "const": true },
          "backupConfirmed": { "const": true },
          "reinstallationAccepted": { "const": true },
          "winreVerified": { "const": true },
          "bitlockerRecoveryState": {
            "enum": ["not_applicable_unencrypted", "recovery_material_confirmed"]
          },
          "recoveryMediaState": { "enum": ["available", "built_in_verified"] },
          "developmentHostProtectionState": { "const": "present_distinct" },
          "explicitUserApprovalTimestamp": { "type": "string", "format": "date-time" },
          "expiresAtEpochMs": { "type": "integer" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "targetType": { "const": "physical_laptop" },
          "approvalStatus": { "const": "approved" }
        },
        "required": ["targetType", "approvalStatus"]
      },
      "then": false
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "operation": {
      "enum": [
        "set_taskbar_widgets_visibility",
        "set_taskbar_task_view_visibility",
        "set_taskbar_show_desktop_enabled"
      ]
    },
    "targetStates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["enabled", "disabled"] }
    }
  },
  "additionalProperties": false
}
